isir_version: '0.1'
module:
  name: LOS_QueueWrite
  clocks:
  - name: clk
    edge: posedge
  resets:
  - name: rst
    polarity: active_high
    async: false
    affects: all
  state: []
  rules:
  - name: LOS_QueueWrite
    action:
    - (write bufferSize 1)
  inputs:
  - name: queueID
    direction: input
    type: bits<32>
  - name: bufferAddr
    direction: input
    type: bits<32>
  - name: bufferSize
    direction: input
    type: bits<32>
  - name: timeout
    direction: input
    type: bits<32>
  abstraction:
    relation:
      name: alpha
      source: LIR
      target: ISIR
      map_expr: lambda sigma. { }
      totality: true
      notes: null
    signals: []
  properties:
  - name: post_0
    kind: safety
    expression:
      kind: always
      operand: 'true'
  proof_obligations:
  - property: post_0
    status: unproved
    engine: model_checking
