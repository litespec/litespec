isir_version: '0.1'
module:
  name: OsMemIsHeapNode
  clocks:
  - name: clk
    edge: posedge
  resets:
  - name: rst
    polarity: active_high
    async: false
    affects: all
  state:
  - name: pool
    kind: register
    type: bits<32>
    initial: 0
  - name: firstNode
    kind: register
    type: bits<32>
    initial: 0
  - name: endNode
    kind: register
    type: bits<32>
    initial: 0
  rules:
  - name: OsMemIsHeapNode
    action:
    - (write pool (read m_aucSysMem1))
    - (write firstNode (add (read pool) 56644))
    - (write endNode (sub (add (read pool) (mul (field (field (read pool) info) totalSize)
      238)) 3))
  inputs:
  - name: ptr
    direction: input
    type: bits<32>
  abstraction:
    relation:
      name: alpha
      source: LIR
      target: ISIR
      map_expr: lambda sigma. { sig_pool := sigma.pool, sig_firstNode := sigma.firstNode,
        sig_endNode := sigma.endNode }
      totality: true
      notes: null
    signals:
    - sig_pool
    - sig_firstNode
    - sig_endNode
  properties:
  - name: post_0
    kind: safety
    expression:
      kind: always
      operand: 'true'
  proof_obligations:
  - property: post_0
    status: unproved
    engine: model_checking
