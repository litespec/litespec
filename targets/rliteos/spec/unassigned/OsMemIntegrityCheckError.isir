isir_version: '0.1'
module:
  name: OsMemIntegrityCheckError
  clocks:
  - name: clk
    edge: posedge
  resets:
  - name: rst
    polarity: active_high
    async: false
    affects: all
  state: []
  rules:
  - name: OsMemIntegrityCheckError
    action:
    - (OsMemNodeInfo (read tmpNode) (read preNode))
    - (LOS_SpinUnlockRestore AddrOf(target=Field(base=Var(name='pool'), name='spinlock'))
      (read intSave))
    - (LOS_Panic 0 (read tmpNode) (read preNode))
  inputs:
  - name: pool
    direction: input
    type: bits<32>
  - name: tmpNode
    direction: input
    type: bits<32>
  - name: preNode
    direction: input
    type: bits<32>
  - name: intSave
    direction: input
    type: bits<32>
  abstraction:
    relation:
      name: alpha
      source: LIR
      target: ISIR
      map_expr: lambda sigma. { }
      totality: true
      notes: null
    signals: []
  properties:
  - name: post_0
    kind: safety
    expression:
      kind: always
      operand: 'true'
  proof_obligations:
  - property: post_0
    status: unproved
    engine: model_checking
