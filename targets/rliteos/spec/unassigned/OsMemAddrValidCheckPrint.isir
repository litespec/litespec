isir_version: '0.1'
module:
  name: OsMemAddrValidCheckPrint
  clocks:
  - name: clk
    edge: posedge
  resets:
  - name: rst
    polarity: active_high
    async: false
    affects: all
  state: []
  rules:
  - name: OsMemAddrValidCheckPrint
    action:
    - (PRINT_ERR 0 (read __FUNCTION__) (read __LINE__) (field Deref(ptr=Var(name='tmpNode'))
      prev))
    - (PRINT_ERR 0 (read __FUNCTION__) (read __LINE__) (field Deref(ptr=Var(name='tmpNode'))
      next))
  inputs:
  - name: pool
    direction: input
    type: bits<32>
  - name: tmpNode
    direction: input
    type: bits<32>
  abstraction:
    relation:
      name: alpha
      source: LIR
      target: ISIR
      map_expr: lambda sigma. { }
      totality: true
      notes: null
    signals: []
  properties:
  - name: post_0
    kind: safety
    expression:
      kind: always
      operand: 'true'
  proof_obligations:
  - property: post_0
    status: unproved
    engine: model_checking
