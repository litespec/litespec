isir_version: '0.1'
module:
  name: OsMemFreeNodeGet
  clocks:
  - name: clk
    edge: posedge
  resets:
  - name: rst
    polarity: active_high
    async: false
    affects: all
  state:
  - name: poolHead
    kind: register
    type: bits<32>
    initial: 0
  - name: index
    kind: register
    type: bits<32>
    initial: 0
  - name: firstNode
    kind: register
    type: bits<32>
    initial: 0
  rules:
  - name: OsMemFreeNodeGet
    action:
    - (write poolHead (read pool))
    - (write firstNode (OsMemFindNextSuitableBlock (read pool) (read size) AddrOf(target=Var(name='index'))))
    - (OsMemListDelete (read poolHead) (read index) (read firstNode))
  inputs:
  - name: pool
    direction: input
    type: bits<32>
  - name: size
    direction: input
    type: bits<32>
  abstraction:
    relation:
      name: alpha
      source: LIR
      target: ISIR
      map_expr: lambda sigma. { sig_poolHead := sigma.poolHead, sig_index := sigma.index,
        sig_firstNode := sigma.firstNode }
      totality: true
      notes: null
    signals:
    - sig_poolHead
    - sig_index
    - sig_firstNode
  properties:
  - name: post_0
    kind: safety
    expression:
      kind: always
      operand: 'true'
  proof_obligations:
  - property: post_0
    status: unproved
    engine: model_checking
