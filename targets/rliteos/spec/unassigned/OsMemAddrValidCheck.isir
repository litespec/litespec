isir_version: '0.1'
module:
  name: OsMemAddrValidCheck
  clocks:
  - name: clk
    edge: posedge
  resets:
  - name: rst
    polarity: active_high
    async: false
    affects: all
  state:
  - name: size
    kind: register
    type: bits<32>
    initial: 0
  rules:
  - name: OsMemAddrValidCheck
    action:
    - (write size (field (field (read pool) info) totalSize))
  inputs:
  - name: pool
    direction: input
    type: bits<32>
  - name: addr
    direction: input
    type: bits<32>
  abstraction:
    relation:
      name: alpha
      source: LIR
      target: ISIR
      map_expr: lambda sigma. { sig_size := sigma.size }
      totality: true
      notes: null
    signals:
    - sig_size
  properties:
  - name: post_0
    kind: safety
    expression:
      kind: always
      operand: 'true'
  proof_obligations:
  - property: post_0
    status: unproved
    engine: model_checking
