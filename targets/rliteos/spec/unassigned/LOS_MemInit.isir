isir_version: '0.1'
module:
  name: LOS_MemInit
  clocks:
  - name: clk
    edge: posedge
  resets:
  - name: rst
    polarity: active_high
    async: false
    affects: all
  state: []
  rules:
  - name: LOS_MemInit
    action:
    - (write size (& (sub (add (UINTPTR (read size)) 1) 1) (^ -1 (UINTPTR 0))))
    - (OsMemPoolDeInit (read pool) (read size))
    - (OsHookCall (read LOS_HOOK_TYPE_MEM_INIT) (read pool) (read size))
  inputs:
  - name: pool
    direction: input
    type: bits<32>
  - name: size
    direction: input
    type: bits<32>
  abstraction:
    relation:
      name: alpha
      source: LIR
      target: ISIR
      map_expr: lambda sigma. { }
      totality: true
      notes: null
    signals: []
  properties:
  - name: post_0
    kind: safety
    expression:
      kind: always
      operand: 'true'
  proof_obligations:
  - property: post_0
    status: unproved
    engine: model_checking
