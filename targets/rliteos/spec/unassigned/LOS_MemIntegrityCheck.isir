isir_version: '0.1'
module:
  name: LOS_MemIntegrityCheck
  clocks:
  - name: clk
    edge: posedge
  resets:
  - name: rst
    polarity: active_high
    async: false
    affects: all
  state:
  - name: poolHead
    kind: register
    type: bits<32>
    initial: 0
  - name: tmpNode
    kind: register
    type: bits<32>
    initial: 0
  - name: preNode
    kind: register
    type: bits<32>
    initial: 0
  - name: intSave
    kind: register
    type: bits<32>
    initial: 0
  rules:
  - name: LOS_MemIntegrityCheck
    action:
    - (write poolHead (read pool))
    - (write tmpNode 0)
    - (write preNode 0)
    - (write intSave 0)
    - (LOS_SpinLockSave AddrOf(target=Field(base=Var(name='poolHead'), name='spinlock'))
      AddrOf(target=Var(name='intSave')))
    - (read __goto_ERROR_OUT)
    - (LOS_SpinUnlockRestore AddrOf(target=Field(base=Var(name='poolHead'), name='spinlock'))
      (read intSave))
    - (read __label_ERROR_OUT)
    - (OsMemIntegrityCheckError (read poolHead) (read tmpNode) (read preNode) (read
      intSave))
  inputs:
  - name: pool
    direction: input
    type: bits<32>
  abstraction:
    relation:
      name: alpha
      source: LIR
      target: ISIR
      map_expr: lambda sigma. { sig_poolHead := sigma.poolHead, sig_tmpNode := sigma.tmpNode,
        sig_preNode := sigma.preNode, sig_intSave := sigma.intSave }
      totality: true
      notes: null
    signals:
    - sig_poolHead
    - sig_tmpNode
    - sig_preNode
    - sig_intSave
  properties:
  - name: post_0
    kind: safety
    expression:
      kind: always
      operand: 'true'
  proof_obligations:
  - property: post_0
    status: unproved
    engine: model_checking
