isir_version: '0.1'
module:
  name: OsMemListDelete
  clocks:
  - name: clk
    edge: posedge
  resets:
  - name: rst
    polarity: active_high
    async: false
    affects: all
  state: []
  rules:
  - name: OsMemListDelete
    action:
    - (write (select (field (read pool) freeList) (read listIndex)) (field (read node)
      next))
    - (OsMemClearFreeListBit (read pool) (read listIndex))
    - (write (field (field (read node) next) prev) 0)
    - (write (field (field (read node) prev) next) (field (read node) next))
    - (write (field (field (read node) next) prev) (field (read node) prev))
    - (write (field (field (read node) header) magic) 2882395322)
  inputs:
  - name: pool
    direction: input
    type: bits<32>
  - name: listIndex
    direction: input
    type: bits<32>
  - name: node
    direction: input
    type: bits<32>
  abstraction:
    relation:
      name: alpha
      source: LIR
      target: ISIR
      map_expr: lambda sigma. { }
      totality: true
      notes: null
    signals: []
  properties:
  - name: post_0
    kind: safety
    expression:
      kind: always
      operand: 'true'
  proof_obligations:
  - property: post_0
    status: unproved
    engine: model_checking
