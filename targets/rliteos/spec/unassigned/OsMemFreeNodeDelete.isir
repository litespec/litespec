isir_version: '0.1'
module:
  name: OsMemFreeNodeDelete
  clocks:
  - name: clk
    edge: posedge
  resets:
  - name: rst
    polarity: active_high
    async: false
    affects: all
  state:
  - name: index
    kind: register
    type: bits<32>
    initial: 0
  rules:
  - name: OsMemFreeNodeDelete
    action:
    - (write index (OsMemFreeListIndexGet (field (field (read node) header) sizeAndFlag)))
    - (LOS_Panic 0 (read index))
    - (OsMemListDelete (read pool) (read index) (read node))
  inputs:
  - name: pool
    direction: input
    type: bits<32>
  - name: node
    direction: input
    type: bits<32>
  abstraction:
    relation:
      name: alpha
      source: LIR
      target: ISIR
      map_expr: lambda sigma. { sig_index := sigma.index }
      totality: true
      notes: null
    signals:
    - sig_index
  properties:
  - name: post_0
    kind: safety
    expression:
      kind: always
      operand: 'true'
  proof_obligations:
  - property: post_0
    status: unproved
    engine: model_checking
