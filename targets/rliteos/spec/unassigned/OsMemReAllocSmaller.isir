isir_version: '0.1'
module:
  name: OsMemReAllocSmaller
  clocks:
  - name: clk
    edge: posedge
  resets:
  - name: rst
    polarity: active_high
    async: false
    affects: all
  state: []
  rules:
  - name: OsMemReAllocSmaller
    action:
    - (write (field (read node) sizeAndFlag) (read nodeSize))
    - (OsMemSplitNode (read pool) (read node) (read allocSize))
    - (write (field (read node) sizeAndFlag) (| (field (read node) sizeAndFlag) 2147483648))
    - (write (field (read node) sizeAndFlag) (| (field (read node) sizeAndFlag) 2147483648))
  inputs:
  - name: pool
    direction: input
    type: bits<32>
  - name: allocSize
    direction: input
    type: bits<32>
  - name: node
    direction: input
    type: bits<32>
  - name: nodeSize
    direction: input
    type: bits<32>
  abstraction:
    relation:
      name: alpha
      source: LIR
      target: ISIR
      map_expr: lambda sigma. { }
      totality: true
      notes: null
    signals: []
  properties:
  - name: post_0
    kind: safety
    expression:
      kind: always
      operand: 'true'
  proof_obligations:
  - property: post_0
    status: unproved
    engine: model_checking
