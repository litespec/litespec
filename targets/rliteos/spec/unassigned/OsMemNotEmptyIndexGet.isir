isir_version: '0.1'
module:
  name: OsMemNotEmptyIndexGet
  clocks:
  - name: clk
    edge: posedge
  resets:
  - name: rst
    polarity: active_high
    async: false
    affects: all
  state:
  - name: mask
    kind: register
    type: bits<32>
    initial: 0
  rules:
  - name: OsMemNotEmptyIndexGet
    action:
    - (write mask (select (field (read poolHead) freeListBitmap) (>> (read index)
      5)))
    - (write mask (& (read mask) (^ -1 (sub (<< 1 (& (read index) 31)) 1))))
    - (write index (add (OsMemFFS (read mask)) (& (read index) -32)))
  inputs:
  - name: poolHead
    direction: input
    type: bits<32>
  - name: index
    direction: input
    type: bits<32>
  abstraction:
    relation:
      name: alpha
      source: LIR
      target: ISIR
      map_expr: lambda sigma. { sig_mask := sigma.mask }
      totality: true
      notes: null
    signals:
    - sig_mask
  properties:
  - name: post_0
    kind: safety
    expression:
      kind: always
      operand: 'true'
  proof_obligations:
  - property: post_0
    status: unproved
    engine: model_checking
