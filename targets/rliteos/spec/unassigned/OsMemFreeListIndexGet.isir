isir_version: '0.1'
module:
  name: OsMemFreeListIndexGet
  clocks:
  - name: clk
    edge: posedge
  resets:
  - name: rst
    polarity: active_high
    async: false
    affects: all
  state:
  - name: fl
    kind: register
    type: bits<32>
    initial: 0
  - name: sl
    kind: register
    type: bits<32>
    initial: 0
  rules:
  - name: OsMemFreeListIndexGet
    action:
    - (write fl (OsMemFlGet (read size)))
    - (write sl (OsMemSlGet (read size) (read fl)))
  inputs:
  - name: size
    direction: input
    type: bits<32>
  abstraction:
    relation:
      name: alpha
      source: LIR
      target: ISIR
      map_expr: lambda sigma. { sig_fl := sigma.fl, sig_sl := sigma.sl }
      totality: true
      notes: null
    signals:
    - sig_fl
    - sig_sl
  properties:
  - name: post_0
    kind: safety
    expression:
      kind: always
      operand: 'true'
  proof_obligations:
  - property: post_0
    status: unproved
    engine: model_checking
