isir_version: '0.1'
module:
  name: LOS_MemPoolList
  clocks:
  - name: clk
    edge: posedge
  resets:
  - name: rst
    polarity: active_high
    async: false
    affects: all
  state:
  - name: nextPool
    kind: register
    type: bits<32>
    initial: 0
  - name: index
    kind: register
    type: bits<32>
    initial: 0
  rules:
  - name: LOS_MemPoolList
    action:
    - (write nextPool (read g_poolHead))
    - (write index 0)
    - (PRINTK 0 (read index))
    - (write index (add (read index) 1))
    - (OsMemInfoPrint (read nextPool))
    - (write nextPool (field (read nextPool) nextPool))
  abstraction:
    relation:
      name: alpha
      source: LIR
      target: ISIR
      map_expr: lambda sigma. { sig_nextPool := sigma.nextPool, sig_index := sigma.index
        }
      totality: true
      notes: null
    signals:
    - sig_nextPool
    - sig_index
  properties:
  - name: post_0
    kind: safety
    expression:
      kind: always
      operand: 'true'
  proof_obligations:
  - property: post_0
    status: unproved
    engine: model_checking
